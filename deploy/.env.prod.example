# Ambiente de produção — a VPS.
#
# Copie para `.env` na raiz do projeto, no servidor, e preencha. Este arquivo é
# o modelo e vai para o repositório; o `.env` de verdade não vai (está no
# .gitignore) e contém segredo.

# ---------------------------------------------------------------- Aplicação

# Nunca True num servidor exposto: True mostra o traceback e a configuração
# inteira em qualquer erro.
DEBUG=False

# Gere uma nova, e não reaproveite a de desenvolvimento:
#   docker compose -f docker-compose.prod.yml run --rm backend \
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-por-uma-chave-gerada

# O domínio, sem esquema. Precisa bater com o que o navegador digita, senão o
# Django responde 400 a tudo.
ALLOWED_HOSTS=seudominio.com.br
INTERNAL_ALLOWED_HOSTS=backend

# Usado pelo nginx para o server_name e para achar o certificado.
DOMAIN=seudominio.com.br

# Origem completa, com https. Sem isto o login do admin responde 403 mesmo com
# a senha certa: atrás de um proxy TLS o Django confere a origem do formulário.
CSRF_TRUSTED_ORIGINS=https://seudominio.com.br

# Um proxy na frente do gunicorn — o nginx desta mesma pilha. É o que permite
# ler o IP real do visitante do X-Forwarded-For, que a contagem de cliques
# únicos e o teto de max_clicks usam. Suba para 2 se puser a Cloudflare na
# frente; deixe 0 se algum dia o Django ficar exposto direto.
TRUSTED_PROXY_COUNT=1

# O nginx já manda o http para o https. Só ligue se tirar o nginx da frente.
SECURE_SSL_REDIRECT=False

# Processos do gunicorn. Uma regra prática é 2 × núcleos + 1.
WEB_CONCURRENCY=3

# ---------------------------------------------------------- Link por subdomínio

# O mesmo domínio de cima, e é o que liga o link por subdomínio:
# `loja-natal.seudominio.com.br`. Deixe vazio para manter só o link de caminho.
#
# Ligar exige três coisas fora daqui, descritas no DEPLOY.md: um registro DNS
# curinga (`*.seudominio.com.br`), um certificado que cubra o curinga (só sai
# pelo desafio DNS-01 do Let's Encrypt) e o `ALLOWED_HOSTS` desta lista — o
# Django acrescenta `.seudominio.com.br` sozinho a partir daqui.
SHORTLINK_BASE_DOMAIN=

# Status do desvio: 302 ou 307. Nunca 301 — o navegador guardaria o destino
# antigo para sempre, e trocar o destino de um link já clicado deixaria de ter
# efeito para quem já clicou.
SHORTLINK_REDIRECT_STATUS=302

# ----------------------------------------------------------------- Banco

DB_NAME=atalho_prancheta
DB_USER=atalho
DB_PASSWORD=troque-por-uma-senha-forte

# ------------------------------------------------------------------ CORS
#
# A interface é servida pelo mesmo domínio da API, então nenhuma requisição é
# de outra origem e a lista pode ficar vazia. Preencha se um dia servir o
# frontend de outro lugar.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=False

# ------------------------------------------------------------------ Sessão

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ------------------------------------------------------------------ Limites

THROTTLE_REGISTER=20/hour
THROTTLE_LOGIN=30/min
THROTTLE_REFRESH=60/min
THROTTLE_LINK_ANON=20/hour
THROTTLE_LINK_USER=120/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_PASSWORD_CONFIRM=30/hour

# ----------------------------------------------------- Redefinição de senha

# O link do e-mail sai de https://DOMAIN, o mesmo domínio de cima. Nunca do Host
# da requisição, que é escrito por quem pede. Declare só se a interface morar
# noutro endereço.
# SITE_URL=https://seudominio.com.br

PASSWORD_RESET_MINUTES=60

# ------------------------------------------------------------------ E-mail
#
# Sem EMAIL_HOST a aplicação sobe do mesmo jeito, mas o e-mail de redefinição
# é impresso no log do backend em vez de enviado — ninguém recebe nada. O
# passo a passo, com o exemplo da Hostinger, está no DEPLOY.md (seção 11).
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 465 fala TLS desde o primeiro byte (EMAIL_USE_SSL); 587 fala STARTTLS
# (EMAIL_USE_TLS). Um ou outro, nunca os dois.
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
# O remetente precisa ser uma caixa que o servidor SMTP aceita enviar como —
# em geral, a mesma de EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=Atalho Prancheta <nao-responda@seudominio.com.br>
