# Django Settings
DEBUG=True
SECRET_KEY=change-me-in-production-use-strong-secret-key

# Database Settings
DB_NAME=atalho_prancheta
DB_USER=postgres
DB_PASSWORD=change-me-strong-password
# DB_HOST/DB_PORT valem para execucao FORA do Docker (venv local).
# Dentro do Compose o servico backend sobrescreve para db:5432.
DB_HOST=localhost
DB_PORT=5433
# Porta publicada no host pelo container do Postgres.
DB_HOST_PORT=5433

# Application Settings
ALLOWED_HOSTS=localhost,127.0.0.1
INTERNAL_ALLOWED_HOSTS=backend
# Quantos proxies reversos confiaveis existem na frente do backend. Define se o
# X-Forwarded-For pode ser usado para identificar o visitante (contagem de cliques
# unicos e teto de max_clicks). 0 = acesso direto, ignora o cabecalho.
# Use 1 ao servir pelo perfil prod (nginx) ou no Render. So aumente com proxies
# confiaveis encadeados — cada unidade a mais confia em uma entrada forjavel.
TRUSTED_PROXY_COUNT=0

# Dominio sob o qual os links por subdominio respondem: `loja-natal.atalho.app`.
# Vazio desliga a funcionalidade — o middleware nem olha o Host, e e o padrao em
# desenvolvimento. Para experimentar local, use `localhost:8000`: o navegador
# resolve `qualquercoisa.localhost` sozinho, sem mexer no arquivo de hosts.
# Em producao exige DNS curinga, certificado curinga e o server_name do nginx
# aceitando o curinga (ver DEPLOY.md).
SHORTLINK_BASE_DOMAIN=
# Status do desvio: 302 ou 307. Nunca 301 — o navegador guardaria o destino
# antigo para sempre e trocar o destino de um link deixaria de ter efeito.
SHORTLINK_REDIRECT_STATUS=302
APP_PORT=8000
FRONTEND_PORT=5173
# Porta do build estático servido por nginx (docker compose --profile prod up)
FRONTEND_PROD_PORT=8080
# Workers do gunicorn na imagem de produção
WEB_CONCURRENCY=3

# JWT Settings
# Access curto porque token assinado nao pode ser revogado antes de expirar;
# o refresh e que carrega a sessao longa e esse da para invalidar (logout).
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Limites por IP nas rotas de conta (formato do DRF: numero/periodo)
THROTTLE_REGISTER=20/hour
THROTTLE_LOGIN=30/min
THROTTLE_REFRESH=60/min
# Criacao de link: por IP para quem nao tem conta, por conta para quem tem.
THROTTLE_LINK_ANON=20/hour
THROTTLE_LINK_USER=120/hour
# Redefinicao de senha: pedir o link e trocar a senha, por IP.
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_PASSWORD_CONFIRM=30/hour

# Redefinicao de senha
# Endereco da interface, usado no link do e-mail. Em desenvolvimento e o Vite;
# em producao sai sozinho de DOMAIN (https://DOMAIN) — so declare para fugir disso.
# SITE_URL=http://localhost:5173
# Quanto tempo o link vale.
PASSWORD_RESET_MINUTES=60

# E-mail
# Sem EMAIL_HOST o e-mail e impresso no log do backend em vez de enviado:
#   docker compose logs -f backend
# E o jeito de testar a redefinicao de senha sem servidor de e-mail nenhum.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 587 usa STARTTLS (EMAIL_USE_TLS); 465 usa TLS direto (EMAIL_USE_SSL). Nunca os dois.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Atalho Prancheta <nao-responda@localhost>

# Cache
# O teto de criacao de link mora no cache; com varios workers ele precisa ser
# compartilhado. No Compose o servico backend ja aponta para o container redis.
# Fora do Compose (venv local), deixe vazio: a aplicacao usa o cache do processo.
# REDIS_URL=redis://localhost:6379/0

# CORS Settings
# Origens autorizadas a chamar a API pelo navegador. O frontend em dev fala com
# o backend pelo proxy do Vite (mesma origem), entao isto so importa se a
# interface for servida de outro dominio.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Escotilha para tunel ou outra porta em desenvolvimento. Deixe False.
CORS_ALLOW_ALL_ORIGINS=False
